r=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="44" y="162" width="344" height="270" /></mxCell><mxCell id="p2-7" value="1 The same incident" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=22;fontStyle=1;fontColor=#215EAF;strokeColor=none;fillColor=none;" vertex="1" parent="p2-6"><mxGeometry as="geometry" x="20" y="17" width="304" height="33.7" /></mxCell><mxCell id="p2-8" value="SRE-006: explain stale reads.&#10;Resource: db-replica-1.&#10;Lag = 120 s; CPU = 92%.&#10;Tool: apply_worker = blocked.&#10;Frozen inputs; 120 s; read-only." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=21;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="p2-6"><mxGeometry as="geometry" x="20" y="60.69999999999999" width="304" height="145.75" /></mxCell><mxCell id="p2-9" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EDF4FF;strokeColor=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="162" width="344" height="270" /></mxCell><mxCell id="p2-10" value="2 OpenSRE backend" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=22;fontStyle=1;fontColor=#215EAF;strokeColor=none;fillColor=none;" vertex="1" parent="p2-9"><mxGeometry as="geometry" x="20" y="17" width="304" height="33.7" /></mxCell><mxCell id="p2-11" value="A: baseline prompt.&#10;B: + guidance to check&#10;replication before blaming CPU.&#10;Same model, tools and limits.&#10;Fresh session for A and B." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=21;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="p2-9"><mxGeometry as="geometry" x="20" y