h 403.&#10;B2: read outside the allowed folder.&#10;V reads it; P rejects the request.&#10;Private tests verify these facts.&#10;Native verdicts are claims to check." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=20;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="p3-21"><mxGeometry as="geometry" x="20" y="60.700000000000045" width="376" height="166.0" /></mxCell><mxCell id="p3-24" value="6 Apply this fixture’s rubric (v1)" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=24;fontStyle=1;fontColor=#087D83;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="504" y="484" width="1100" height="36.4" /></mxCell><mxCell id="p3-25" value="" style="rounded=0;arcSize=8;absoluteArcSize=1;fillColor=#E6EDF5;strokeColor=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="504" y="532" width="512" height="48" /></mxCell><mxCell id="p3-26" value="Check" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=19;fontStyle=1;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="516" y="541" width="488" height="29.65" /></mxCell><mxCell id="p3-27" value="" style="rounded=0;arcSize=8;absoluteArcSize=1;fillColor=#E6EDF5;strokeColor=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1016" y="532" width="120" height="48" /></mxCell><mxCell id="p3-28" value="A" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=19;fontStyle=1;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1028" y="541" width="96" height="29.65" /></mxCell><mxCell id="