_id + candidate version + attempt_id + artifacts + status/error + elapsed time + tokens + cost +&#10;human effort. Missing evidence stays “unknown”." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=19;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="p1-49"><mxGeometry as="geometry" x="20" y="60.700000000000045" width="880" height="55.3" /></mxCell><mxCell id="p1-52" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EDF4FF;strokeColor=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1000" y="905" width="636" height="142" /></mxCell><mxCell id="p1-53" value="7 Goal → next experiment" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=22;fontStyle=1;fontColor=#215EAF;strokeColor=none;fillColor=none;" vertex="1" parent="p1-52"><mxGeometry as="geometry" x="20" y="17" width="596" height="33.7" /></mxCell><mxCell id="p1-54" value="Keep the same checks. Prefer quality, lower cost or lower latency.&#10;Change one component, then repeat within that project." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=19;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="p1-52"><mxGeometry as="geometry" x="20" y="60.700000000000045" width="596" height="55.3" /></mxCell><mxCell id="p1-55" value="* OpenKritt step data needs a separate collection seam; the findings ZIP alone is insufficient. Adapters and the shared engine are proposed." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=15;fontStyle=0;fontColor=#4E6276;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="44" y="871" width="1550" height="24.25" /></mxCell></root></mxGraphModel><