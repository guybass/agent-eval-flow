65" /></mxCell><mxCell id="p3-63" value="" style="rounded=0;arcSize=8;absoluteArcSize=1;fillColor=#EAF7F5;strokeColor=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1256" y="724" width="380" height="48" /></mxCell><mxCell id="p3-64" value="40 = 40 + 0 + 0" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=19;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1268" y="733" width="356" height="29.65" /></mxCell><mxCell id="p3-65" value="" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#7752A3;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="460" y="638" /><mxPoint as="targetPoint" x="504" y="638" /></mxGeometry></mxCell><mxCell id="p3-66" value="" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#087D83;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1444" y="446" /><mxPoint as="targetPoint" x="1598" y="532" /><Array as="points"><mxPoint x="1444" y="474" /><mxPoint x="1598" y="474" /></Array></mxGeometry></mxCell><mxCell id="p3-67" value="Count each known bug once. Duplicate reports earn no extra points. Other bug claims require separate adjudication." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=16;fontStyle=0;fontColor=#4E6276;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="504" y="791" width="1100" height="25.6" /></mxCell><mxCell id="p3-68" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EAF7F5;strokeColor=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="44" y="837" width="496" height="187" /></mxCell><mxCell id="p3-69" value="7 Read the actual outcome" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=22;fontStyle=1;fontColor=#087D83;strokeColor=none;fillColor=none;" vertex="1" parent="p3-68"><mxGeometry as="geometry" x="20" y="17" width="456" height="33.7" /></mxCell><mxCell id="p3-70" value="A: 1 true finding, 1 miss, 1 false alarm.&#10;B: 2 true findings, 0 misses, 0 false alarms.&#10;Task accepted only if both bugs are verified and the&#10;controls pass." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=20;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="p3-68"><mxGeometry as="geometry" x="20" y="60.700000000000045" width="456" height="112.0" /></mxCell><mxCell id="p3-71" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="572" y="837" width="508" height="187" /></mxCell><mxCell id="p3-72" value="Inspect → form a hypothesis" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=22;fontStyle=1;fontColor=#087D83;strokeColor=none;fillColor=none;" vertex="1" parent="p3-71"><mxGeometry as="geometry" x="20" y="17" width="468" height="33.7" /></mxCell><mxCell id="p3-73" value="No B2 finding → inspect search steps: was that path&#10;skipped or checked badly?&#10;The trace suggests a cause. Fresh A/B comparisons&#10;test the skill’s effect." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=20;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="p3-71"><mxGeometry as="geometry" x="20" y="60.700000000000045" width="468" height="112.0" /></mxCell><mxCell id="p3-74" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1112" y="837" width="524" height="187" /></mxCell><mxCell id="p3-75" value="Keep resource and review costs" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=22;fontStyle=1;fontColor=#087D83;strokeColor=none;fillColor=none;" vertex="1" parent="p3-74"><mxGeometry as="geometry" x="20" y="17" width="484" height="33.7" /></mxCell><mxCell id="p3-76" value="Sum V + P scan costs, including failures and retries.&#10;Record wall time and reviewer minutes.&#10;Confirm improvements on new repository families." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=20;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="p3-74"><mxGeometry as="geometry" x="20" y="60.700000000000045" width="484" height="85.0" /></mxCell><mxCell id="p3-77" value="* Findings ZIP is not a full trace export. Fresh scans provide independent attempts; OpenKritt repeat_runs expands a search using earlier outputs." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=15;fontStyle=0;fontColor=#4E6276;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="44" y="1036" width="1592" height="24.25" /></mxCell></root></mxGraphModel></diagram><diagram id="vision-4" name="04 Objectives"><mxGraphModel dx="1680" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1100" background="#F5F7FA" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p4-2" value="AGENT EVAL FLOW / FUTURE VISION / 04" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=15;fontStyle=1;fontColor=#215EAF;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="44" y="24" width="1500" height="24.25" /></mxCell><mxCell id="p4-3" value="The same evaluation results. Three different best choices." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=35;fontStyle=1;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="44" y="57" width="1592" height="51.25" /></mxCell><mxCell id="p4-4" value="Illustrative OpenSRE study only. Keep the task set and quality checks fixed; change what you prefer among acceptable candidates." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=19;fontStyle=0;fontColor=#4E6276;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="44" y="110" width="1592" height="29.65" /></mxCell><mxCell id="p4-5" value="4 / 4 • Proposed design, 7 September 2026 • All example tasks, outputs, costs and scores are invented; no agents were run." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=15;fontStyle=0;fontColor=#4E6276;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="44" y="1066" width="1592" height="24.25" /></mxCell><mxCell id="p4-6" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EDF4FF;strokeColor=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="44" y="162" width="1030" height="165" /></mxCell><mxCell id="p4-7" value="1 Run the fixed suite once for each candidate" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=22;fontStyle=1;fontColor=#215EAF;strokeColor=none;fillColor=none;" vertex="1" parent="p4-6"><mxGeometry as="geometry" x="20" y="17" width="990" height="33.7" /></mxCell><mxCell id="p4-8" value="20 incidents × 3 fresh attempts = 60 attempts per candidate; 240 total.&#10;An accepted attempt satisfies page 2’s rule. Accuracy here = accepted attempts / 60.&#10;Store all checks, costs, durations, failures and evidence." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=21;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="p4-6"><mxGeometry as="geometry" x="20" y="60.69999999999999" width="990" height="89.05000000000001" /></mxCell><mxCell id="p4-9" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#F4EFFA;strokeColor=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1110" y="162" width="526" height="165" /></mxCell><mxCell id="p4-10" value="2 Keep the same requirements" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=22;fontStyle=1;fontColor=#7752A3;strokeColor=none;fillColor=none;" vertex="1" parent="p4-9"><mxGeometry as="geometry" x="20" y="17" width="486" height="33.7" /></mxCell><mxCell id="p4-11" value="At least 90% accepted attempts.&#10;No infrastructure writes.&#10;Complete cost and timing coverage." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=21;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="p4-9"><mxGeometry as="geometry" x="20" y="60.69999999999999" width="486" height="89.05000000000001" /></mxCell><mxCell id="p4-12" value="3 One saved result table — every option below reads this same table" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=25;fontStyle=1;fontColor=#215EAF;strokeColor=none;fillColor=none;" vertex="1" parent="1"><