tainer=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="44" y="817" width="496" height="207" /></mxCell><mxCell id="p2-76" value="7 Score + acceptance + resources" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=22;fontStyle=1;fontColor=#215EAF;strokeColor=none;fillColor=none;" vertex="1" parent="p2-75"><mxGeometry as="geometry" x="20" y="17" width="456" height="33.7" /></mxCell><mxCell id="p2-77" value="A: 35/100; FAIL; $0.18; 70 s.&#10;B: 100/100; PASS; $0.22; 85 s.&#10;Pass: ≥80 + correct cause + completed ≤120 s +&#10;no writes." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=21;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="p2-75"><mxGeometry as="geometry" x="20" y="60.700000000000045" width="456" height="117.4" /></mxCell><mxCell id="p2-78" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFF0EE;strokeColor=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="572" y="817" width="508" height="207" /></mxCell><mxCell id="p2-79" value="Open the reason behind the score" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=22;fontStyle=1;fontColor=#AD3E3B;strokeColor=none;fillColor=none;" vertex="1" parent="p2-78"><mxGeometry as="geometry" x="20" y="17" width="468" height="33.7" /></mxCell><mxCell id="p2-80" value="Lost 50 cause points → predicted CPU → hidden&#10;replication answer → telemetry evidence.&#10;Lost 15 remedy points → CPU scaling does not&#10;address the fixture fault." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=20;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="p2-78"><mxGeometry as="geometry" x="20" y="60.700000000000045" width="468" height="112.0" /></mxCell><mxCell id="p2-81" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1112" y="817" width="524" height="207" /></mxCell><mxCell id="p2-82" value="Then test across incidents" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=22;fontStyle=1;fontColor=#215EAF;strokeColor=none;fillColor=none;" vertex="1" parent="p2-81"><mxGeometry as="geometry" x="20" y="17" width="484" height="33.7" /></mxCell><mxCell id="p2-83" value="One incident is one task, even with 20 tool calls.&#10;Compare fresh attempts on misleading alerts and&#10;missing telemetry.&#10;This one example does not prove B is better overall." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=20;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="p2-81"><mxGeometry as="geometry" x="20" y="60.700000000000045" width="484" height="112.0" /></mxCell><mxCell id="p2-84" value="* CLI JSON provides status/response/denied_tools/error. Structured diagnosis and audit capture need a pipeline adapter; this is not a promised CLI export." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=15;fontStyle=0;fontColor=#4E6276;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="44" y="1036" width="1592" height="24.25" /></mxCell></root></mxGraphModel></diagram><diagram id="vision-3" name="03 Openkritt"><mxGraphModel dx="1680" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1100" background="#F5F7FA" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p3-2" value="AGENT EVAL FLOW / FUTURE VISION / 03" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=15;fontStyle=1;fontColor=#215EAF;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="44" y="24" width="1500" height="24.25" /></mxCell><mxCell id="p3-3" value="OpenKritt: did a review skill find more real bugs?" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=35;fontStyle=1;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="44" y="57" width="1592" height="51.25" /></mxCell><mxCell id="p3-4" value="An independent security study. Its scores are meaningful within this study; they do not rank OpenKritt against OpenSRE." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=19;fontStyle=0;fontColor=#4E6276;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="44" y="110" width="1592" height="29.65" /></mxCell><mxCell id="p3-5" value="3 / 4 • Proposed design, 7 September 2026 • All example tasks, outputs, costs and scores are invented; no agents were run." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=15;fontStyle=0;fontColor=#4E6276;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="44" y="1066" width="1592" height="24.25" /></mxCell><mxCell id="p3-6" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EAF7F5;strokeColor=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="44" y="162" width="344" height="284" /></mxCell><mxCell id="p3-7" value="1 A tiny repository task" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=22;fontStyle=1;fontColor=#087D83;strokeColor=none;fillColor=none;" vertex="1" parent="p3-6"><mxGeometry as="geometry" x="20" y="17" width="304" height="33.7" /></mxCell><mxCell id="p3-8" value="Task K-001 has two snapshots:&#10;V: missing ownership check (B1);&#10;unsafe path handling (B2).&#10;P: both bugs fixed.&#10;Fresh scans; agent sees code.&#10;Bug IDs and tests stay private." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=20;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="p3-6"><mxGeometry as="geometry" x="20" y="60.69999999999999" width="304" height="166.0" /></mxCell><mxCell id="p3-9" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EAF7F5;strokeColor=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="162" width="344" height="284" /></mxCell><mxCell id="p3-10" value="2 OpenKritt backend" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=22;fontStyle=1;fontColor=#087D83;strokeColor=none;fillColor=none;" vertex="1" parent="p3-9"><mxGeometry as="geometry" x="20" y="17" width="304" height="33.7" /></mxCell><mxCell id="p3-11" value="A: baseline workflow W1.&#10;B: W1 + review skill for ownership&#10;and path handling.&#10;Same model, flow and budgets.&#10;Search → findings → native&#10;validation / dedup / ranking." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=20;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="p3-9"><mxGeometry as="geometry" x="20" y="60.69999999999999" width="304" height="166.0" /></mxCell><mxCell id="p3-12" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="816" y="162" width="394" height="284" /></mxCell><mxCell id="p3-13" value="3 Native outputs" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=22;fontStyle=1;fontColor=#087D83;strokeColor=none;fillColor=none;" vertex="1" parent="p3-12"><mxGeometry as="geometry" x="20" y="17" width="354" height="33.7" /></mxCell><mxCell id="p3-14" value="Finding text + file_path + line&#10;Summary + trigger_flow&#10;Reproduction claim&#10;Findings ZIP + scan status&#10;Separate step records: raw output,&#10;lineage, timings and usage*" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=20;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="p3-12"><mxGeometry as="geometry" x="20" y="60.69999999999999" width="354" height="166.0" /></mxCell><mxCell id="p3-15" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1252" y="162" width="384" height="284" /></mxCell><mxCell id="p3-16" value="4 Invented final findings" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=22;fontStyle=1;fontColor=#087D83;strokeColor=none;fillColor=none;" vertex="1" parent="p3-15"><mxGeometry as="geometry" x="20" y="17" width="344" height="33.7" /></mxCell><mxCell id="p3-17" value="A on V: reports B1; misses B2.&#10;A on P: falsely reports B1.&#10;B on V: reports B1 and B2.&#10;B on P: reports neither.&#10;Adapter attaches finding IDs and&#10;snapshot / candidate versions." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=20;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="p3-15"><mxGeometry as="geometry" x=