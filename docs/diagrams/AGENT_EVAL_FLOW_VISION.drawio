Size=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="960" y="606" width="232" height="53" /></mxCell><mxCell id="p4-68" value="65 s" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=19;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="972" y="615" width="208" height="29.65" /></mxCell><mxCell id="p4-69" value="" style="rounded=0;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1192" y="606" width="220" height="53" /></mxCell><mxCell id="p4-70" value="0" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=19;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1204" y="615" width="196" height="29.65" /></mxCell><mxCell id="p4-71" value="" style="rounded=0;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1412" y="606" width="224" height="53" /></mxCell><mxCell id="p4-72" value="Yes" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=19;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1424" y="615" width="200" height="29.65" /></mxCell><mxCell id="p4-73" value="Cost = total declared run spend / all 60 attempts, including retries and failures. Duration = end-to-end wall time; p95 uses all attempts." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=17;fontStyle=0;fontColor=#4E6276;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="44" y="672" width="1592" height="26.95" /></mxCell><mxCell id="p4-74" value="4 Change only the selection objective" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=25;fontStyle=1;fontColor=#215EAF;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="44" y="728" width="1592" height="37.75" /></mxCell><mxCell id="p4-75" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EAF7F5;strokeColor=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="44" y="777" width="508" height="166" /></mxCell><mxCell id="p4-76" value="Spend less → choose B" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=22;fontStyle=1;fontColor=#087D83;strokeColor=none;fillColor=none;" vertex="1" parent="p4-75"><mxGeometry as="geometry" x="20" y="17" width="468" height="33.7" /></mxCell><mxCell id="p4-77" value="Lowest mean cost that meets requirements.&#10;$0.24 per attempt; 90% accepted.&#10;A is cheaper but fails the quality floor." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=21;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="p4-75"><mxGeometry as="geometry" x="20" y="60.700000000000045" width="468" height="89.05000000000001" /></mxCell><mxCell id="p4-78" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EDF4FF;strokeColor=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="586" y="777" width="508" height="166" /></mxCell><mxCell id="p4-79" value="Respond faster → choose D" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=22;fontStyle=1;fontColor=#215EAF;strokeColor=none;fillColor=none;" vertex="1" parent="p4-78"><mxGeometry as="geometry" x="20" y="17" width="468" height="33.7" /></mxCell><mxCell id="p4-80" value="Lowest p95 duration that meets requirements.&#10;65 s; 95% accepted.&#10;More parallel work costs $0.90 per attempt." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=21;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="p4-78"><mxGeometry as="geometry" x="20" y="60.700000000000045" width="468" height="89.05000000000001" /></mxCell><mxCell id="p4-81" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#F4EFFA;strokeColor=#D7E0E8;strokeWidth=1.3;html=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1128" y="777" width="508" height="166" /></mxCell><mxCell id="p4-82" value="Maximize accuracy → choose C" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=22;fontStyle=1;fontColor=#7752A3;strokeColor=none;fillColor=none;" vertex="1" parent="p4-81"><mxGeometry as="geometry" x="20" y="17" width="468" height="33.7" /></mxCell><mxCell id="p4-83" value="Highest acceptance rate.&#10;59/60 = 98.3%; $0.65 per attempt.&#10;Allow p95 duration up to 120 s." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=21;fontStyle=0;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="p4-81"><mxGeometry as="geometry" x="20" y="60.700000000000045" width="468" height="89.05000000000001" /></mxCell><mxCell id="p4-84" value="No rerun is needed to change this preference. To improve the agent itself, create candidate E and run the fixed suite again." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=23;fontStyle=1;fontColor=#172C42;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="44" y="974" width="1592" height="35.05" /></mxCell><mxCell id="p4-85" value="These are sample choices, not proven population winners. Use per-incident uncertainty and held-out confirmation; three repeats are not three new incidents." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Segoe UI;fontSize=17;fontStyle=0;fontColor=#4E6276;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="44" y="1019" width="1592" height="26.95" /></mxCell></root></mxGraphModel></diagram></mxfile>