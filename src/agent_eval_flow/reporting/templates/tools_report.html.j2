<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tools · {{ view.title }}</title><style>{{ css|safe }}</style></head>
<body>
<header><p class="eyebrow">AGENT EVAL FLOW · TOOL CALL EVALUATION</p><h1>{{ view.title }} · Tools</h1>
<p><a href="{{ view.general_href }}">General report</a> · <a href="{{ view.json_href }}">Tools JSON</a></p>
<p>Result {{ view.result_id }}. Scores describe captured requests at the declared boundary. Tool completion and task success are separate observations.</p></header>
<main>
<section><h2>Candidate comparison</h2><p>Mean composite over applicable scored runs, grouped by candidate and scoring settings. Missing, error and no-tool cases are excluded and counted explicitly.</p>
<div class="table-wrap"><table><thead><tr><th>Candidate</th><th>Mean score</th><th>Scored</th><th>Missing</th><th>Error</th><th>Not applicable</th><th>Settings</th></tr></thead><tbody>
{% for row in view.summaries %}<tr><td>{{ row.candidate }}</td><td>{{ '%.3f'|format(row.mean) if row.mean is not none else 'unknown' }}</td><td>{{ row.observed }}</td><td>{{ row.missing }}</td><td>{{ row.error }}</td><td>{{ row.not_applicable }}</td><td><details><summary>View settings</summary><pre>{{ row.settings|pretty_json }}</pre></details></td></tr>{% else %}<tr><td colspan="7">No readable Toolscore receipts.</td></tr>{% endfor %}
</tbody></table></div></section>
{% for run in view.runs %}
<section id="{{ run.anchor }}"><h2>{{ run.candidate_id }} · {{ run.unit|pretty_json }}</h2>
<p>Run {{ run.run_id }} · <a href="{{ view.general_href }}#{{ run.general_anchor }}">Open run in general report</a></p>
{% for item in run.receipts %}
{% if item.error %}<p>Receipt unavailable or invalid: {{ item.error }}</p>{% else %}
{% set receipt = item.receipt %}
<p><strong>{{ receipt.status }}</strong> · {{ receipt.reason }}</p>
{% if receipt.trace %}<p>Boundary: {{ receipt.trace.boundary }} · Scope: {{ receipt.trace.scope }}<br>
Request coverage: {{ receipt.trace.coverage.status }} / {{ receipt.trace.coverage.value if receipt.trace.coverage.value is not none else 'unknown' }} · {{ receipt.trace.coverage.reason }}</p>{% endif %}
<p>Toolscore {{ receipt.toolscore_version or 'not invoked' }} · Adapter {{ receipt.evaluator.revision }}</p>
<div class="table-wrap"><table><thead><tr><th>Metric</th><th>Value</th><th>Status</th><th>Meaning / limits</th></tr></thead><tbody>
{% for name, metric in receipt.metrics.items() %}<tr><td>{{ name }}</td><td>{{ '%.3f'|format(metric.value) if metric.value is not none else 'unavailable' }}</td><td>{{ metric.status }}</td><td>{{ metric.reason }}</td></tr>{% else %}<tr><td colspan="4">No scores: {{ receipt.reason }}</td></tr>{% endfor %}
</tbody></table></div>
<h3>Tools used</h3><p>Counts retain retries. “Completed” records a returned result, not independently verified correctness. Required counts use the selected predeclared alternative; no per-tool score is inferred.</p>
<div class="table-wrap"><table><thead><tr><th>Tool</th><th>Required</th><th>Requested</th><th>Completed</th><th>Returned error</th><th>Completion unknown</th></tr></thead><tbody>
{% for tool in item.tools %}<tr><td>{{ tool.tool }}</td><td>{{ tool.expected if tool.expected is not none else 'unknown' }}</td><td>{{ tool.actual }}</td><td>{{ tool.completed }}</td><td>{{ tool.errors }}</td><td>{{ tool.unknown }}</td></tr>{% else %}<tr><td colspan="6">No retained tool requests. Consult coverage and contract status above.</td></tr>{% endfor %}
</tbody></table></div>
{% if receipt.alternatives %}<details open><summary>Expected calls · selected alternative {{ receipt.selected_alternative }}</summary>
<pre>{{ receipt.alternatives[receipt.selected_alternative].expected|pretty_json }}</pre></details>{% endif %}
{% if receipt.trace %}<h3>Observed requests, in captured request order</h3>
{% for call in receipt.trace.calls %}<details><summary>{{ loop.index }}. {{ call.tool }} · {{ call.call_id }} · {{ call.completion }}</summary>
<p>Execution {{ call.execution_id }}{% for execution in receipt.get('executions', []) if execution.id == call.execution_id %} · Parent {{ execution.parent_id or 'none' }} · Retry index {{ execution.retry_index }}{% endfor %}</p><h4>Arguments</h4><pre>{{ call.arguments|pretty_json }}</pre>
<h4>Recorded result</h4>{% if call.completion == 'unknown' %}<p>Unknown: no completion was retained.</p>{% else %}<pre>{{ call.result|pretty_json }}</pre>{% endif %}
<ul>{% for ref in call.evidence + call.result_evidence %}<li>{% set href = evidence_link(ref.artifact.uri) %}{% if href %}<a href="{{ href }}">{{ ref.description or 'Source evidence' }}</a>{% else %}Source unavailable{% endif %} · {{ ref.locator }} · SHA-256 {{ ref.artifact.sha256 }}</li>{% endfor %}</ul>
</details>{% endfor %}{% endif %}
<p>Tool latency: unknown · Tool cost: unknown. {{ receipt.resources.reason }}</p>
<details><summary>Contract, settings, alternatives and original Toolscore metrics</summary><pre>{{ receipt|pretty_json }}</pre></details>
{% endif %}
{% else %}<p>No Toolscore receipt was retained for this run. No score is inferred.</p><pre>{{ run.measurements|pretty_json }}</pre>{% endfor %}
</section>{% endfor %}
<section><h2>Evidence bundle</h2><p>Verified local evidence is copied alongside these reports. Source locations remain recorded for provenance. No remote evidence is fetched.</p>
<ul>{% for item in view.evidence %}<li>{% if item.bundled_uri %}<a href="{{ item.bundled_uri }}">{{ item.media_type }}</a> · SHA-256 {{ item.sha256 }}{% else %}Unavailable: {{ item.uri }} · {{ item.error }}{% endif %}</li>{% endfor %}</ul></section>
</main><footer>Saved evaluation only · No agent calls or grading during rendering</footer></body></html>
